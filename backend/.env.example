# Application Settings
PROJECT_NAME=Ancestra
ENV=development
DEBUG=True
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
# NOTE: Ensure PostgreSQL is running and the database and user exist:
# CREATE USER ancestra_user WITH PASSWORD 'ancestra_password';
# CREATE DATABASE ancestra_db OWNER ancestra_user;
# CREATE DATABASE ancestra_test_db OWNER ancestra_user;
# GRANT ALL PRIVILEGES ON DATABASE ancestra_db TO ancestra_user;
# GRANT ALL PRIVILEGES ON DATABASE ancestra_test_db TO ancestra_user;
DATABASE_URL=postgresql://ancestra_user:ancestra_password@localhost:5432/ancestra_db
TEST_DATABASE_URL=postgresql://ancestra_user:ancestra_password@localhost:5432/ancestra_test_db

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# Setup Notes:
# - Authorized JavaScript Origins: http://localhost:8000, http://localhost:5173
# - Authorized Redirect URIs: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Optional: Restrict authentication to a specific Google Workspace domain (e.g. yourorganization.org)
GOOGLE_ALLOWED_DOMAIN=

# JWT Authentication Configuration
# Generate a cryptographically secure key for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Models & Weights
SAM_CHECKPOINT_PATH=app/ai/model_weights/sam_vit_b_01ec64.pth
SAM_MODEL_TYPE=vit_b
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
DEVICE=cpu

# Storage & Logging
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO
