# Application Settings
PROJECT_NAME=Ancestra
ENV=development
DEBUG=True
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration (SQLite default for dev, switch to Postgres in production)
DATABASE_URL=sqlite:///./ancestra.db
# DATABASE_URL=postgresql://ancestra_user:ancestra_password@localhost:5432/ancestra_db

# AI Models & Weights
SAM_CHECKPOINT_PATH=app/ai/model_weights/sam_vit_h_4b8939.pth
SAM_MODEL_TYPE=vit_h
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
DEVICE=cuda

# Storage & Logging
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO
